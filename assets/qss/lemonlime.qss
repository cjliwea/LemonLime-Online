/* LemonLime global theme: clean light + lemon green */

QPushButton {
	background-color: #FFFFFF;
	border: 1px solid #D4D4D8;
	border-radius: 6px;
	padding: 5px 14px;
}

QPushButton:hover {
	background-color: #F4F4F5;
}

QPushButton:disabled {
	color: #A1A1AA;
	background-color: #FAFAFA;
}

QPushButton#PrimaryBtn {
	background-color: #84CC16;
	color: #1A2E05;
	font-weight: bold;
}

QPushButton#PrimaryBtn:hover {
	background-color: #65A30D;
	color: #FFFFFF;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
	border: 1px solid #D4D4D8;
	border-radius: 4px;
	padding: 4px 8px;
	background-color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
	border: 1px solid #84CC16;
}

QTableView, QTableWidget {
	border: 1px solid #E5E7EB;
	gridline-color: #F1F5F9;
	background-color: #FFFFFF;
	selection-background-color: #ECFCCB;
	selection-color: #0F172A;
}

QHeaderView::section {
	background-color: #F8FAFC;
	padding: 6px;
	border: none;
	border-bottom: 1px solid #E5E7EB;
	color: #475569;
}

QTabWidget::pane {
	border: 1px solid #E5E7EB;
	border-radius: 6px;
	background-color: #FFFFFF;
	position: relative;
	top: -1px;
}

QTabBar::tab {
	padding: 7px 18px;
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
	color: #64748B;
}

QTabBar::tab:selected {
	background-color: #FFFFFF;
	color: #0F172A;
	font-weight: bold;
	border: 1px solid #E5E7EB;
}

QGroupBox {
	border: 1px solid #E5E7EB;
	border-radius: 6px;
	margin-top: 12px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	left: 10px;
	padding: 0 4px;
	color: #475569;
	font-weight: bold;
}

QMenuBar::item:selected, QMenu::item:selected {
	background-color: #F7FEE7;
	color: #3F6212;
}

QMenu {
	border: 1px solid #E5E7EB;
}

QToolBar {
	background-color: #FFFFFF;
	border: none;
	spacing: 4px;
}

QToolButton {
	border-radius: 6px;
	padding: 5px;
}

QToolButton:hover {
	background-color: #F4F4F5;
}

QStatusBar {
	background-color: #F8FAFC;
}

QStatusBar::item {
	border: none;
}

QLabel#welcomeBadge {
	color: #94A3B8;
	padding: 2px 10px;
	border: 1px solid #E5E7EB;
	border-radius: 10px;
}

QProgressBar {
	height: 8px;
	border: none;
	background-color: #F1F5F9;
	border-radius: 4px;
	text-align: center;
}

QProgressBar::chunk {
	background-color: #84CC16;
	border-radius: 4px;
}

/* 评测对话框大号总体进度条 */
QProgressBar#JudgeProgressBar {
	height: 22px;
	border: none;
	background-color: #F1F5F9;
	border-radius: 11px;
	color: #3F6212;
	font-weight: 600;
}

QProgressBar#JudgeProgressBar::chunk {
	background-color: #84CC16;
	border-radius: 11px;
}

/* 工具栏主按钮（全部评测） */
QToolButton#PrimaryBtn {
	background-color: #84CC16;
	color: #1A2E05;
	border: 1px solid #65A30D;
	border-radius: 6px;
	padding: 6px 16px;
	font-weight: 600;
}

QToolButton#PrimaryBtn:hover {
	background-color: #65A30D;
	color: #FFFFFF;
}

QToolButton#PrimaryBtn:disabled {
	background-color: #F1F5F9;
	color: #94A3B8;
	border-color: #E2E8F0;
}

/* 日志浏览区 */
QTextBrowser {
	background-color: #FFFFFF;
	border: 1px solid #E5E7EB;
	border-radius: 6px;
	color: #334155;
}

/* 状态栏右侧在线服务状态标签 */
QLabel#onlineSvcLabel {
	color: #64748B;
	padding-right: 8px;
}

/* 自绘标题栏（无边框窗口，macOS 红绿灯窗控） */
TitleBar {
	background: #F8FAFC;
	border-bottom: 1px solid #E5E7EB;
}

TitleBar QLabel#TitleBarText {
	color: #0F172A;
	font-weight: 600;
	padding-left: 6px;
}

TitleBar QPushButton {
	border: none;
	border-radius: 7px;
	min-width: 14px;
	max-width: 14px;
	min-height: 14px;
	max-height: 14px;
	color: transparent;
	font-size: 9px;
	font-weight: 700;
}

/* 悬停标题栏时圆点内浮现符号 */
TitleBar[hover="true"] QPushButton {
	color: rgba(0, 0, 0, 0.55);
}

TitleBar QPushButton#TbMin {
	background: #FBBF24;
}

TitleBar QPushButton#TbMin:pressed {
	background: #D69E0B;
}

TitleBar QPushButton#TbMax {
	background: #34D399;
}

TitleBar QPushButton#TbMax:pressed {
	background: #0EA47A;
}

TitleBar QPushButton#TbClose {
	background: #F87171;
}

TitleBar QPushButton#TbClose:pressed {
	background: #DC2626;
}
